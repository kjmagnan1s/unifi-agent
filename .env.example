# unifi-agent configuration (copy to .env, or better: use `unifi-agent setup` to store
# secrets in the macOS Keychain instead of a plaintext file).
#
# Secrets are resolved in this order: environment > .env file > macOS Keychain.
# Prefer the Keychain for anything sensitive.

# --- Connection ---------------------------------------------------------------
# Gateway LAN address (IP or hostname). The tool connects here directly; it never
# routes management traffic through the cloud.
UNIFI_HOST=192.168.1.1

# Site name inside the Network application. "default" for a single-site console.
UNIFI_SITE=default

# TLS: the console ships a self-signed certificate. On first connect the tool pins
# the exact certificate to ~/.config/unifi-agent/pinned-cert.pem and refuses to talk
# to any other certificate afterward (trust-on-first-use). Re-pin with
# `unifi-agent trust --repin` after a firmware update rotates the cert.
# Set to "insecure" ONLY for throwaway testing — it disables MITM protection.
UNIFI_TLS=pin

# --- Auth: Integration API (official, X-API-KEY) ------------------------------
# Covers devices, clients, networks, WLANs, firewall, guest auth, restart, etc.
# Create at: UniFi console -> Settings -> Control Plane -> Integrations -> Create API Key.
# Store via: `unifi-agent setup` (recommended) — do NOT paste it here in shared repos.
# UNIFI_API_KEY=

# --- Auth: classic API (cookie+CSRF, local admin) -----------------------------
# Only needed for capabilities the Integration API does not expose: AP radio tuning,
# client block/kick, speedtest trigger, events/alarms, historical reports, backups.
# Use a DEDICATED, LOCAL-ONLY, least-privilege admin — never your owner account.
# Store via: `unifi-agent setup`.
# UNIFI_USERNAME=
# UNIFI_PASSWORD=

# --- Safety defaults ----------------------------------------------------------
# Global kill switch for all mutations. "true" = read-only, refuse every write.
UNIFI_READ_ONLY=false

# Refuse mutations classified above this blast radius unless explicitly overridden.
# One of: client, device, wlan_group, site, gateway
UNIFI_MAX_BLAST_RADIUS=device

# Automatically create a config backup before any mutation above "device" radius.
UNIFI_BACKUP_BEFORE_RISKY=true

# HTTP request timeout in seconds.
UNIFI_TIMEOUT=30

# --- Advanced -----------------------------------------------------------------
# Path to an extra .env file to load (wins over the config-dir .env, never over real env
# vars). A .env in the current working directory is deliberately NOT auto-loaded, so a
# stray/hostile .env cannot redirect your credentials to another host. Opt in explicitly:
# UNIFI_ENV_FILE=/path/to/my.env
